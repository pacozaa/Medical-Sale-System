# Neon Postgres connection string (use the "pooled" connection string from Neon)
DATABASE_URL="postgresql://<user>:<password>@ep-example.neon.tech/medical_sales?sslmode=require"

# Direct (non-pooled) connection string, used for migrations
DIRECT_URL="postgresql://<user>:<password>@ep-example.neon.tech/medical_sales?sslmode=require"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
